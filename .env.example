# LLM：走 OpenAI 兼容协议，换供应商只改这三行
QA_AGENT_BASE_URL=https://api.anthropic.com/v1/
QA_AGENT_API_KEY=sk-ant-xxx
QA_AGENT_MODEL=claude-sonnet-5

# roadbook 资产仓库位置
# 单仓库布局时使用旁边的 roadbook/；独立布局时改成实际路径。
ROADBOOK_REPO=../roadbook

# Vercel Deployment Protection（可选）。在项目 Settings → Deployment Protection →
# Protection Bypass for Automation 生成。密钥只会发给下面精确列出的 host。
VERCEL_AUTOMATION_BYPASS_SECRET=
QA_AGENT_VERCEL_BYPASS_HOSTS=app.example.com,app-preview.example.com

# 同时最多几个跑批在跑，超过的排队等空位；0 = 不限。默认 10（不写这行也是 10）
QA_AGENT_MAX_CONCURRENT_RUNS=10

# 原子记忆层：模型只能提议和投票，代码数票落盘。下面全是默认值，不写也一样
QA_AGENT_ATOM_MEMORY=on                 # 总开关
QA_AGENT_ATOM_CONFIRMS_APPEND=1         # 给已有原子追加一条要几票确认（须来自另一次跑批）
QA_AGENT_ATOM_CONFIRMS_CANONICAL=2      # 改「它长什么样」要几票（且不同场景；这版只收不办）
QA_AGENT_ATOM_REFUTES_DROP=1            # 候选被几票否决就丢
QA_AGENT_ATOM_REFUTES_DEMOTE=2          # 已落盘条目被几个跑批否决就划掉（预留）
QA_AGENT_ATOM_PENDING_TTL_DAYS=30       # 候选多少天没人验证就过期

# prod 围栏：默认关——看板不许触发线上（prod）跑批，prod 建出来的用户删不掉。
# 确实要对线上跑回归的人显式打开，改完重启服务生效。
QA_AGENT_ALLOW_PROD=off

# 跑批结束推飞书（自定义机器人 webhook 地址）。留空 = 不推；推送失败不影响跑批结论。
QA_AGENT_WEBHOOK_URL=

# 结论非 PASS 的清理任务保持窗口（小时）。窗口内可以在跑批详情页「重跑裁判」：
# 只重新取证判分，不重跑执行、不再扣积分。到点由垃圾回收点照常清理。
QA_AGENT_CLEANUP_HOLD_HOURS=4

# ---- 环境隔离与清理策略（2026-11-10） ----
# 所有自动化都跑在一个隔离测试环境里；数据可累积，靠下面的 GC 台账周期清。
QA_AGENT_ENV_PROFILE=test
# 隔离测试环境入口。留空 = 用场景自己声明的 target_url。
QA_AGENT_TEST_ENV_URL=
# 完整隔离边界：只隔 DB 不够——邮件/存储/第三方任一仍是真实出口，副作用就会漏出去。
# email 可选 sink / stub / live；external_api 可选 sandbox / stub / live。
QA_AGENT_ISOLATION_DB=
QA_AGENT_ISOLATION_EMAIL=
QA_AGENT_ISOLATION_STORAGE=
QA_AGENT_ISOLATION_EXTERNAL_API=
# 每个跑批的命名空间前缀，防累积数据跨跑批撞名 / 唯一键冲突。
QA_AGENT_RUN_NAMESPACE=rb
# immediate = 旧行为（PASS 后立即清）；deferred_gc = 隔离 + 延迟 GC（推荐，非技术场景）。
QA_AGENT_CLEANUP_MODE=deferred_gc
QA_AGENT_GC_INTERVAL_HOURS=24
QA_AGENT_GC_RETAIN_DAYS=7
QA_AGENT_GC_MAX_PER_SWEEP=50
